# Blockchain Configuration for Polygon Amoy Testnet
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Polygon Amoy RPC URL
# Get from: https://docs.polygon.technology/tools/endpoints/
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key for deployment (with testnet funds)
# Generate with: https://docs.polygon.technology/tools/wallets/
PRIVATE_KEY=your_private_key_here

# Contract address (filled after deployment)
CONTRACT_ADDRESS=

# PolygonScan API Key (for contract verification)
# Get from: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=

# Chain ID for Polygon Amoy
CHAIN_ID=80002

# For local development (Hardhat local network)
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BLOCKCHAIN_CONTRACT_ADDRESS=