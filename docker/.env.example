# SIH26106 Forensics - Docker Environment Configuration
# Copy this file to .env and .env.frontend and adjust values

# PostgreSQL Configuration
POSTGRES_DB=sih26106
POSTGRES_USER=forensics
POSTGRES_PASSWORD=changeme_in_production

# Backend Configuration
DATABASE_URL=postgresql+asyncpg://forensics:changeme_in_production@postgres:5432/sih26106
REDIS_URL=redis://redis:6379/0
OLLAMA_HOST=http://host.docker.internal:11434

# Frontend Configuration (for docker/.env.frontend)
NEXT_PUBLIC_API_URL=http://backend:8000
NEXT_PUBLIC_USE_MOCK=false

# Blockchain Configuration (Hardhat runs on host)
HARDHAT_RPC_URL=http://host.docker.internal:8545
HARDHAT_CHAIN_ID=31337

# Optional: Logging
LOG_LEVEL=INFO
